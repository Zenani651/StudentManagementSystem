@model IEnumerable<StudentManagementSystem.Models.Lecturer>

@{
    ViewData["Title"] = "Lecturers";
}

<h2>Lecturers</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add Lecturer
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Any())
        {
            @foreach (var lecturer in Model)
            {
                <tr>
                    <td>@lecturer.FirstName</td>
                    <td>@lecturer.LastName</td>
                    <td>@lecturer.Email</td>
                    <td>@lecturer.Department?.DepartmentName</td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@lecturer.LecturerId" class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@lecturer.LecturerId" class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    No lecturers found.
                </td>
            </tr>
        }

    </tbody>

</table>
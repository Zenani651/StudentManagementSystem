@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<h2>Delete Student</h2>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this student?</h4>
</div>

<div class="mb-3">
    <strong>Student Number:</strong> @Model.StudentNumber
</div>

<div class="mb-3">
    <strong>Name:</strong> @Model.FirstName @Model.LastName
</div>

<div class="mb-3">
    <strong>Email:</strong> @Model.Email
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="StudentId" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
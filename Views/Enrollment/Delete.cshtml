@model StudentManagementSystem.Models.Enrollment

@{
    ViewData["Title"] = "Delete Enrollment";
}

<h2>Delete Enrollment</h2>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this enrollment?</h4>
</div>

<p>
    <strong>Student:</strong>
    @Model.Student?.FirstName @Model.Student?.LastName
</p>

<p>
    <strong>Course:</strong>
    @Model.Course?.CourseName
</p>

<p>
    <strong>Enrollment Date:</strong>
    @Model.EnrollmentDate.ToShortDateString()
</p>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="EnrollmentId" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>
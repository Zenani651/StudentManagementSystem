@model StudentManagementSystem.Models.Enrollment

@{
    ViewData["Title"] = "Edit Enrollment";
}

<h2>Edit Enrollment</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="EnrollmentId" />

    <div class="mb-3">
        <label asp-for="StudentId" class="form-label"></label>
        <select asp-for="StudentId" asp-items="ViewBag.Students" class="form-control">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="CourseId" class="form-label"></label>
        <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-control">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="EnrollmentDate"></label>
        <input asp-for="EnrollmentDate" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Grade"></label>
        <input asp-for="Grade" class="form-control" />
    </div>

    <button type="submit" class="btn btn-warning">
        Save Changes
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>
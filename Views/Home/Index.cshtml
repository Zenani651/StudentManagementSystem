@{
    ViewData["Title"] = "Dashboard";
}

<div class="alert alert-info">
    <h4>Welcome to the Student Management System</h4>

    <p>
        Use the dashboard below to manage students, courses, and enrollments.
    </p>
</div>

<div class="row">

    <!-- Students -->
    <div class="col-md-3 mb-4">
        <div class="card shadow h-100">
            <div class="card-body d-flex flex-column text-center">

                <h5 class="card-title">👨‍🎓 Students</h5>

                <h1 class="display-4">@ViewBag.StudentCount</h1>

                <div class="mt-auto">
                    <a asp-controller="Student" asp-action="Index" class="btn btn-primary w-100">
                        Manage Students
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- Courses -->
    <div class="col-md-3 mb-4">
        <div class="card shadow h-100">
            <div class="card-body d-flex flex-column text-center">

                <h5 class="card-title">📚 Courses</h5>

                <h1 class="display-4">@ViewBag.CourseCount</h1>

                <div class="mt-auto">
                    <a asp-controller="Course" asp-action="Index" class="btn btn-success w-100">
                        Manage Courses
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- Enrollments -->
    <div class="col-md-3 mb-4">
        <div class="card shadow h-100">
            <div class="card-body d-flex flex-column text-center">

                <h5 class="card-title">📝 Enrollments</h5>

                <h1 class="display-4">@ViewBag.EnrollmentCount</h1>

                <div class="mt-auto">
                    <a asp-controller="Enrollment" asp-action="Index" class="btn btn-warning w-100">
                        Manage Enrollments
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- Active Students -->
    <div class="col-md-3 mb-4">
        <div class="card shadow h-100">
            <div class="card-body d-flex flex-column text-center">

                <h5 class="card-title">✅ Active Students</h5>

                <h1 class="display-4">@ViewBag.ActiveStudents</h1>

                <div class="mt-auto">
                    <a asp-controller="Student" asp-action="Index" class="btn btn-outline-success w-100">
                        View Students
                    </a>
                </div>

            </div>
        </div>
    </div>

</div>
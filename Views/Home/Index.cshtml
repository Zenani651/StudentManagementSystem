@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mb-4">
    <div class="p-4 bg-info-subtle border border-info rounded">
        <h1 class="display-6 fw-bold">
            Welcome to the Student Management System
        </h1>

        @if (User.IsInRole("Admin"))
        {
            <p class="lead">
                Use the dashboard below to manage students, courses, and enrollments.
            </p>
        }
        else if (User.IsInRole("Lecturer"))
        {
            <p class="lead">
                Welcome Lecturer. Manage your courses and academic information.
            </p>
        }
        else if (User.IsInRole("Student"))
        {
            <p class="lead">
                Welcome Student. View your courses, enrollments and academic information.
            </p>
        }
    </div>
</div>


@if (User.IsInRole("Admin"))
{
    <!-- ADMIN DASHBOARD -->
    <div class="row g-4">

        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h4>🎓 Students</h4>

                    <a asp-controller="Student" asp-action="Index" class="btn btn-primary w-100">
                        Manage Students
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h4>📚 Courses</h4>

                    <a asp-controller="Course" asp-action="Index" class="btn btn-success w-100">
                        Manage Courses
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h4>📝 Enrollments</h4>

                    <a asp-controller="Enrollment" asp-action="Index" class="btn btn-warning w-100">
                        Manage Enrollments
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h4>✅ Active Students</h4>

                    <a asp-controller="Student" asp-action="Index" class="btn btn-outline-success w-100">
                        View Students
                    </a>
                </div>
            </div>
        </div>

    </div>
}


@if (User.IsInRole("Lecturer"))
{
    <!-- LECTURER DASHBOARD -->
    <div class="row g-4">

        <div class="col-md-6">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h4>📚 My Courses</h4>

                    <p>View and manage your courses.</p>

                    <a asp-controller="Course" asp-action="Index" class="btn btn-success">
                        View Courses
                    </a>
                </div>
            </div>
        </div>

    </div>
}


@if (User.IsInRole("Student"))
{
    <!-- STUDENT DASHBOARD -->
    <div class="row g-4">

        <div class="col-md-6">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h4>📝 My Enrollments</h4>

                    <p>View your enrolled courses.</p>

                    <a asp-controller="Enrollment" asp-action="Index" class="btn btn-warning">
                        View Enrollments
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h4>📚 My Courses</h4>

                    <p>View the courses available to you.</p>

                    <a asp-controller="Enrollment" asp-action="Index" class="btn btn-primary">
                        View My Courses
                    </a>
                </div>
            </div>
        </div>

    </div>
}